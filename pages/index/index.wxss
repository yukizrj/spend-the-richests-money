.page-shell {
  position: relative;
  min-height: 100vh;
  padding: 0 28rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 10% 3%, rgba(14, 165, 233, .16), transparent 28%),
    radial-gradient(circle at 95% 20%, rgba(99, 102, 241, .13), transparent 25%),
    #07111f;
}

.ambient {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
  filter: blur(100rpx);
}

.ambient-one {
  top: 220rpx;
  right: -160rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(35, 178, 255, .12);
}

.ambient-two {
  top: 850rpx;
  left: -180rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(124, 58, 237, .1);
}

.compact-hud {
  position: fixed;
  z-index: 80;
  top: calc(env(safe-area-inset-top) + 14rpx);
  right: 22rpx;
  left: 22rpx;
  padding: 18rpx 22rpx 14rpx;
  border: 1rpx solid rgba(125, 211, 252, .25);
  border-radius: 22rpx;
  opacity: 0;
  background: rgba(8, 19, 33, .94);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, .34);
  pointer-events: none;
  transform: translateY(-130%);
  transition: opacity .2s, transform .25s;
  backdrop-filter: blur(24rpx);
}

.compact-hud.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.compact-hud-main,
.compact-hud-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.compact-balance {
  min-width: 0;
  flex: 1;
}

.compact-label {
  color: #71849a;
  font-size: 17rpx;
  line-height: 1;
}

.compact-value {
  margin-top: 7rpx;
  overflow: hidden;
  color: #f8fafc;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-time {
  flex: none;
  margin-left: 20rpx;
  text-align: right;
}

.compact-time-value {
  margin-top: 3rpx;
  color: #7dd3fc;
  font-size: 36rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.compact-hud-bottom {
  gap: 18rpx;
  margin-top: 14rpx;
}

.compact-spent {
  flex: none;
  color: #86efac;
  font-size: 18rpx;
  font-weight: 750;
}

.compact-progress {
  height: 7rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, .14);
}

.compact-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #22c55e, #38bdf8);
  transition: width .1s linear;
}

.nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 26rpx) 4rpx 26rpx;
}

.brand {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.brand-mark {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(125, 211, 252, .45);
  border-radius: 20rpx;
  color: #dff6ff;
  background: linear-gradient(145deg, rgba(14, 165, 233, .3), rgba(30, 64, 175, .18));
  box-shadow: inset 0 0 20rpx rgba(56, 189, 248, .14);
  font-size: 30rpx;
  font-weight: 900;
  font-style: italic;
}

.brand-title {
  color: #f8fafc;
  font-size: 25rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  text-shadow: 0 0 20rpx rgba(56, 189, 248, .25);
}

.brand-subtitle {
  margin-top: 4rpx;
  color: #718096;
  font-size: 19rpx;
}

.status-dot {
  display: flex;
  gap: 10rpx;
  align-items: center;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(148, 163, 184, .18);
  border-radius: 999rpx;
  color: #64748b;
  background: rgba(15, 23, 42, .75);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.status-dot .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #64748b;
}

.status-dot.is-live {
  color: #86efac;
}

.status-dot.is-live .dot {
  background: #22c55e;
  box-shadow: 0 0 16rpx #22c55e;
  animation: blink 1.1s infinite;
}

.hero {
  position: relative;
  z-index: 1;
  padding: 42rpx 0 24rpx;
  text-align: center;
}

.eyebrow {
  color: #6f849d;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.balance {
  margin-top: 12rpx;
  color: #fff;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: -2rpx;
  text-shadow: 0 0 45rpx rgba(56, 189, 248, .2);
  word-break: break-all;
}

.income-chip {
  display: inline-flex;
  gap: 8rpx;
  align-items: center;
  margin-top: 14rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(34, 197, 94, .2);
  border-radius: 999rpx;
  color: #86efac;
  background: rgba(34, 197, 94, .08);
  font-size: 22rpx;
  transition: transform .2s, background .2s;
}

.income-chip.pulse {
  background: rgba(34, 197, 94, .14);
  transform: scale(1.025);
}

.income-basis {
  margin-top: 12rpx;
  color: #52647a;
  font-size: 18rpx;
}

.trend {
  font-weight: 900;
}

.timer-card {
  margin-top: 42rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(148, 163, 184, .14);
  border-radius: 30rpx;
  background: linear-gradient(145deg, rgba(21, 35, 54, .95), rgba(11, 23, 39, .95));
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, .18);
  text-align: left;
}

.timer-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.timer-label,
.target-label {
  color: #708198;
  font-size: 20rpx;
}

.timer-value {
  margin-top: 6rpx;
  font-size: 50rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.target {
  text-align: right;
}

.target-value {
  margin-top: 10rpx;
  color: #7dd3fc;
  font-size: 23rpx;
  font-weight: 700;
}

.progress-track {
  height: 10rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, .12);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0ea5e9, #6366f1);
  box-shadow: 0 0 20rpx rgba(56, 189, 248, .5);
  transition: width .1s linear;
}

.stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin: 10rpx 0 24rpx;
  padding: 24rpx 8rpx;
  border-top: 1rpx solid rgba(148, 163, 184, .1);
  border-bottom: 1rpx solid rgba(148, 163, 184, .1);
}

.mission-progress {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.mission-item {
  display: flex;
  min-width: 0;
  gap: 10rpx;
  padding: 16rpx 12rpx;
  align-items: center;
  border: 1rpx solid rgba(148, 163, 184, .11);
  border-radius: 18rpx;
  background: rgba(15, 28, 45, .72);
}

.mission-check {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #74869b;
  background: rgba(148, 163, 184, .1);
  font-size: 17rpx;
  font-weight: 800;
}

.mission-item.done {
  border-color: rgba(34, 197, 94, .2);
  background: rgba(22, 101, 52, .08);
}

.mission-item.done .mission-check {
  color: #bbf7d0;
  background: rgba(34, 197, 94, .2);
}

.mission-label {
  overflow: hidden;
  color: #607187;
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-value {
  max-width: 120rpx;
  margin-top: 3rpx;
  overflow: hidden;
  color: #d7e1ec;
  font-size: 18rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-label {
  color: #66778d;
  font-size: 19rpx;
}

.stat-value {
  max-width: 210rpx;
  margin: 8rpx auto 0;
  overflow: hidden;
  color: #e2e8f0;
  font-size: 24rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-value.green {
  color: #4ade80;
}

.divider {
  width: 1rpx;
  height: 50rpx;
  background: rgba(148, 163, 184, .12);
}

.ticker {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 15rpx;
  align-items: center;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(56, 189, 248, .12);
  border-radius: 18rpx;
  color: #9eb0c4;
  background: rgba(14, 165, 233, .055);
  font-size: 21rpx;
}

.ticker-icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(14, 165, 233, .12);
  font-size: 20rpx;
}

.ticker-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leaderboard-card {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 26rpx 24rpx 18rpx;
  border: 1rpx solid rgba(250, 204, 21, .15);
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(250, 204, 21, .08), transparent 34%),
    rgba(15, 28, 45, .82);
}

.leaderboard-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.rank-badge {
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #fde68a;
  background: rgba(234, 179, 8, .12);
  font-size: 18rpx;
  font-weight: 800;
}

.leaderboard-empty {
  padding: 24rpx 0 16rpx;
  color: #66788e;
  font-size: 21rpx;
  text-align: center;
}

.rank-row {
  display: flex;
  min-width: 0;
  align-items: center;
  padding: 16rpx 4rpx;
  border-top: 1rpx solid rgba(148, 163, 184, .08);
}

.rank-number {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #71839a;
  background: rgba(100, 116, 139, .1);
  font-size: 18rpx;
  font-weight: 900;
}

.rank-number.top-1 {
  color: #422006;
  background: linear-gradient(145deg, #fde68a, #eab308);
}

.rank-number.top-2 {
  color: #253244;
  background: linear-gradient(145deg, #e2e8f0, #94a3b8);
}

.rank-number.top-3 {
  color: #431407;
  background: linear-gradient(145deg, #fdba74, #c2410c);
}

.rank-name {
  min-width: 0;
  flex: 1;
  margin-left: 14rpx;
  overflow: hidden;
  color: #dbe5f0;
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-count {
  margin-right: 16rpx;
  color: #62758b;
  font-size: 18rpx;
}

.rank-score {
  color: #7dd3fc;
  font-size: 22rpx;
  font-weight: 850;
}

.sweep-card {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(244, 114, 182, .28);
  border-radius: 22rpx;
  background: linear-gradient(120deg, rgba(190, 24, 93, .13), rgba(124, 58, 237, .1));
  box-shadow: 0 14rpx 40rpx rgba(0, 0, 0, .12);
}

.sweep-card.is-active {
  border-color: rgba(74, 222, 128, .26);
  background: linear-gradient(120deg, rgba(22, 163, 74, .13), rgba(14, 116, 144, .1));
}

.sweep-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #fbcfe8;
  background: rgba(244, 114, 182, .15);
  font-size: 26rpx;
  font-weight: 900;
}

.is-active .sweep-icon {
  color: #bbf7d0;
  background: rgba(74, 222, 128, .14);
}

.sweep-copy {
  min-width: 0;
  flex: 1;
}

.sweep-title {
  color: #f8fafc;
  font-size: 23rpx;
  font-weight: 800;
}

.sweep-desc {
  margin-top: 6rpx;
  color: #8193a8;
  font-size: 18rpx;
  line-height: 1.4;
}

.sweep-button,
.sweep-live {
  flex: none;
  padding: 14rpx 17rpx;
  border-radius: 15rpx;
  color: #fff;
  background: linear-gradient(120deg, #db2777, #7c3aed);
  font-size: 20rpx;
  font-weight: 800;
}

.sweep-live {
  color: #86efac;
  background: rgba(34, 197, 94, .12);
}

.sweep-wait {
  flex: none;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  color: #77889c;
  background: rgba(100, 116, 139, .09);
  font-size: 18rpx;
  font-weight: 700;
}

.shop-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 44rpx 2rpx 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
}

.section-caption {
  margin-top: 8rpx;
  color: #66778d;
  font-size: 20rpx;
}

.shop-count {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #74869b;
  background: rgba(148, 163, 184, .08);
  font-size: 19rpx;
}

.category-group {
  position: relative;
  z-index: 1;
  margin-bottom: 34rpx;
}

.category-head {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin: 0 2rpx 16rpx;
}

.category-icon {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(125, 211, 252, .13);
  border-radius: 16rpx;
  background: rgba(14, 165, 233, .07);
  font-size: 27rpx;
}

.category-copy {
  min-width: 0;
  flex: 1;
}

.category-name {
  color: #e8eef5;
  font-size: 25rpx;
  font-weight: 850;
}

.category-caption {
  margin-top: 3rpx;
  color: #5f7288;
  font-size: 18rpx;
}

.category-count {
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  color: #71849a;
  background: rgba(100, 116, 139, .08);
  font-size: 17rpx;
}

.product-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.product-card {
  min-width: 0;
  padding: 24rpx 22rpx 20rpx;
  border: 1rpx solid rgba(148, 163, 184, .14);
  border-radius: 26rpx;
  background: linear-gradient(145deg, rgba(21, 35, 54, .88), rgba(11, 23, 39, .92));
  box-shadow: 0 15rpx 42rpx rgba(0, 0, 0, .14);
  transition: opacity .2s, transform .15s;
}

.product-card.disabled {
  opacity: .48;
}

.product-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.product-meta {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  align-items: flex-end;
}

.product-emoji {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(148, 163, 184, .11);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .035);
  font-size: 42rpx;
}

.owned {
  min-width: 42rpx;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  color: #bae6fd;
  background: rgba(14, 165, 233, .14);
  font-size: 19rpx;
  font-weight: 800;
  text-align: center;
}

.stock {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  color: #71859b;
  background: rgba(100, 116, 139, .09);
  font-size: 16rpx;
  font-weight: 700;
}

.stock.sold-out {
  color: #fda4af;
  background: rgba(225, 29, 72, .1);
}

.product-name {
  margin-top: 22rpx;
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-note {
  height: 58rpx;
  margin-top: 7rpx;
  overflow: hidden;
  color: #627388;
  font-size: 19rpx;
  line-height: 29rpx;
}

.product-note.lock-note {
  color: #8b7fa8;
}

.product-card.locked .product-emoji {
  filter: grayscale(1);
  opacity: .55;
}

.product-bottom {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  min-height: 58rpx;
}

.product-price {
  display: block;
  min-width: 100rpx;
  flex: 1;
  overflow: hidden;
  color: #7dd3fc;
  font-size: 23rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-stack {
  min-width: 0;
  flex: 1;
}

.price-tier {
  display: inline-block;
  margin-top: 5rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  color: #60758d;
  background: rgba(100, 116, 139, .08);
  font-size: 15rpx;
  font-weight: 700;
}

.stepper {
  display: flex;
  gap: 8rpx;
  flex: none;
  align-items: center;
}

.step-button {
  display: flex;
  width: 55rpx;
  height: 55rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #dbeafe;
  background: rgba(56, 189, 248, .14);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 55rpx;
  box-sizing: border-box;
}

.step-button.minus {
  color: #7e90a5;
  background: rgba(148, 163, 184, .08);
}

.step-button.button-disabled {
  color: #465466;
  background: rgba(71, 85, 105, .08);
  opacity: .6;
}

.bottom-space {
  height: 60rpx;
}

.start-overlay,
.decision-overlay,
.result-overlay {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 42rpx;
  align-items: center;
  justify-content: center;
  background: rgba(3, 9, 17, .82);
  backdrop-filter: blur(22rpx);
}

.decision-overlay {
  z-index: 100;
}

.start-panel,
.decision-panel,
.result-panel {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 58rpx 42rpx 42rpx;
  border: 1rpx solid rgba(125, 211, 252, .2);
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(14, 165, 233, .18), transparent 38%),
    linear-gradient(150deg, #142238, #091422 70%);
  box-shadow: 0 40rpx 130rpx rgba(0, 0, 0, .55);
  text-align: center;
}

.decision-panel {
  padding: 38rpx 34rpx 34rpx;
  text-align: left;
}

.decision-status {
  display: flex;
  gap: 10rpx;
  align-items: center;
  color: #7dd3fc;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.decision-pause-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 16rpx rgba(56, 189, 248, .8);
  animation: blink 1.1s infinite;
}

.decision-asset {
  display: inline-block;
  margin-top: 34rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  color: #fde68a;
  background: rgba(234, 179, 8, .1);
  font-size: 19rpx;
  font-weight: 800;
}

.decision-title {
  margin-top: 20rpx;
  color: #f8fafc;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.42;
}

.decision-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 34rpx;
}

.decision-option {
  display: flex;
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 20rpx;
  gap: 18rpx;
  align-items: center;
  border: 1rpx solid rgba(125, 211, 252, .18);
  border-radius: 20rpx;
  color: #e6edf5;
  background: rgba(15, 32, 52, .82);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.4;
  text-align: left;
}

.decision-option::after {
  border: 0;
}

.decision-option-key {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #7dd3fc;
  background: rgba(14, 165, 233, .13);
  font-size: 20rpx;
  font-weight: 900;
}

.decision-result-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  margin: 34rpx auto 24rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 45rpx;
  font-weight: 900;
}

.decision-result-icon.positive {
  color: #86efac;
  background: rgba(34, 197, 94, .13);
}

.decision-result-icon.negative {
  color: #fda4af;
  background: rgba(244, 63, 94, .13);
}

.decision-result-kicker {
  color: #71849a;
  font-size: 19rpx;
  text-align: center;
}

.decision-result-title {
  margin-top: 12rpx;
  color: #f8fafc;
  font-size: 38rpx;
  font-weight: 900;
  text-align: center;
}

.decision-result-message {
  margin: 18rpx 4rpx 0;
  color: #91a3b8;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.decision-delta {
  margin: 22rpx 0 30rpx;
  font-size: 44rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.decision-delta.positive {
  color: #4ade80;
}

.decision-delta.negative {
  color: #fb7185;
}

.start-icon {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 30rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(125, 211, 252, .25);
  border-radius: 34rpx;
  background: rgba(14, 165, 233, .1);
  box-shadow: 0 0 50rpx rgba(14, 165, 233, .15);
  font-size: 58rpx;
}

.start-kicker {
  color: #38bdf8;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.start-title {
  margin-top: 18rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: -1rpx;
}

.start-title text {
  display: block;
}

.start-title-main {
  color: #fff;
  font-size: 58rpx;
  text-shadow:
    0 0 26rpx rgba(56, 189, 248, .3),
    0 10rpx 36rpx rgba(0, 0, 0, .25);
}

.start-title-callout {
  margin-top: 15rpx;
  color: #7dd3fc;
  font-size: 36rpx;
  letter-spacing: 1rpx;
}

.start-title-sub {
  display: inline-block !important;
  margin-top: 13rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(250, 204, 21, .24);
  border-radius: 999rpx;
  color: #fde68a;
  background: rgba(234, 179, 8, .08);
  font-size: 23rpx;
  letter-spacing: 2rpx;
}

.start-desc {
  margin: 26rpx auto 34rpx;
  color: #91a3b8;
  font-size: 23rpx;
  line-height: 1.7;
}

.nickname-field {
  margin: 0 0 26rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(148, 163, 184, .15);
  border-radius: 20rpx;
  background: rgba(3, 10, 20, .3);
  text-align: left;
}

.nickname-label {
  color: #687b91;
  font-size: 18rpx;
}

.nickname-input {
  height: 52rpx;
  margin-top: 5rpx;
  color: #f8fafc;
  font-size: 25rpx;
  font-weight: 700;
}

.primary-button {
  display: flex;
  height: 94rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(120deg, #0284c7, #4f46e5);
  box-shadow: 0 20rpx 40rpx rgba(37, 99, 235, .22);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 94rpx;
}

.result-panel {
  padding-top: 48rpx;
}

.result-panel.won {
  border-color: rgba(74, 222, 128, .24);
  background:
    radial-gradient(circle at 50% 0%, rgba(34, 197, 94, .18), transparent 40%),
    linear-gradient(150deg, #142b2a, #091422 70%);
}

.result-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  width: 280rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(14, 165, 233, .12);
  filter: blur(60rpx);
  transform: translateX(-50%);
}

.result-emoji {
  position: relative;
  font-size: 76rpx;
}

.result-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.result-message {
  margin: 20rpx 10rpx 28rpx;
  color: #91a3b8;
  font-size: 23rpx;
  line-height: 1.6;
}

.result-summary {
  display: flex;
  margin-bottom: 30rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, .1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .025);
}

.result-summary view {
  flex: 1;
}

.result-summary view + view {
  border-left: 1rpx solid rgba(148, 163, 184, .12);
}

.result-summary text {
  display: block;
}

.result-summary .summary-label {
  color: #64748b;
  font-size: 19rpx;
}

.result-summary .summary-value {
  margin-top: 8rpx;
  color: #dbeafe;
  font-size: 23rpx;
  font-weight: 700;
}

.ghost-button {
  margin-top: 18rpx;
  color: #718096;
  background: transparent;
  font-size: 22rpx;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}
